# Copy this file to ".env" and fill in your Amadeus Self-Service credentials.
# Get them free at https://developers.amadeus.com  (create an app -> API Key + API Secret)

AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# "test" = free but LIMITED/cached data (Helena will be sparse).
# "production" = full data, 2,000 free calls/month, then small per-call fee.
AMADEUS_ENV=test

# Optional: change the local port (default 5173)
# PORT=5173
